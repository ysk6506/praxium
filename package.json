{
  "name": "praxium",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @praxium/web typecheck",
    "test": "vitest run --coverage",
    "structure": "tsx harness/src/run-all.ts --with-coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm structure",
    "check:pr": "pnpm lint && pnpm typecheck && pnpm test && tsx harness/src/run-all.ts --with-coverage --base origin/main",
    "ratchet": "tsx harness/src/checks/coverage.ts ratchet && tsx harness/src/checks/debt.ts ratchet && tsx harness/src/checks/ignores.ts ratchet",
    "quality": "tsx harness/src/checks/quality.ts",
    "lock-tests": "tsx harness/src/checks/testguard.ts lock",
    "web:gen-api": "tsx scripts/web-gen-api.ts",
    "web:build": "bash scripts/build-with-web.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "fast-check": "4.10.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.8.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
