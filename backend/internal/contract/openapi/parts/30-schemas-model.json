{
  "components": {
    "schemas": {
      "Property": {
        "type": "object",
        "description": "One property of a type, a trait or a link type.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The property id."
          },
          "attr_no": {
            "type": "integer",
            "description": "The stable attribute number."
          },
          "name": {
            "type": "string",
            "description": "The property name."
          },
          "aliases": {
            "type": "array",
            "description": "Old names that still resolve.",
            "items": {
              "type": "string",
              "description": "An old name."
            }
          },
          "value_type": {
            "type": "string",
            "description": "The id of the value type."
          },
          "unit": {
            "type": ["string", "null"],
            "description": "The unit of the value, when it has one."
          },
          "enum_values": {
            "type": "array",
            "description": "The allowed values of an enum.",
            "items": {
              "type": "string",
              "description": "An allowed value."
            }
          },
          "required": {
            "type": "boolean",
            "description": "Whether an object must have it."
          },
          "change_class": {
            "type": "string",
            "description": "How the value changes: static, slow or volatile."
          },
          "sensitivity": {
            "type": "string",
            "description": "How sensitive the value is."
          },
          "history_kind": {
            "type": "string",
            "description": "How history is kept."
          },
          "scope_key": {
            "type": "boolean",
            "description": "Whether the property is a scope key."
          },
          "status": {
            "type": "string",
            "description": "The lifecycle status."
          },
          "superseded_by": {
            "type": ["string", "null"],
            "description": "The property that replaces it."
          },
          "description": {
            "type": "string",
            "description": "What the property means."
          }
        },
        "required": [
          "id",
          "attr_no",
          "name",
          "aliases",
          "value_type",
          "unit",
          "enum_values",
          "required",
          "change_class",
          "sensitivity",
          "history_kind",
          "scope_key",
          "status",
          "superseded_by",
          "description"
        ]
      },
      "Need": {
        "type": "object",
        "description": "One channel a type needs.",
        "properties": {
          "channel": {
            "type": "string",
            "description": "The channel name."
          },
          "strength": {
            "type": ["string", "null"],
            "description": "hard or soft."
          }
        },
        "required": ["channel", "strength"]
      },
      "KeyComponent": {
        "type": "object",
        "description": "One component of an identity key.",
        "properties": {
          "kind": {
            "type": "string",
            "description": "property, set or context.",
            "enum": ["property", "set", "context"]
          },
          "ref": {
            "type": "string",
            "description": "The property or context the component names."
          },
          "incoming": {
            "type": "boolean",
            "description": "Whether the context is read against the link direction."
          },
          "size": {
            "type": "integer",
            "description": "The size of a set component; 0 otherwise."
          }
        },
        "required": ["kind", "ref", "incoming", "size"]
      },
      "IdentityKey": {
        "type": "object",
        "description": "One identity key of a type, in priority order.",
        "properties": {
          "strength": {
            "type": "string",
            "description": "strong or weak."
          },
          "scheme": {
            "type": ["string", "null"],
            "description": "The identifier scheme, when the key is an external identifier."
          },
          "components": {
            "type": "array",
            "description": "The components of the key.",
            "items": {
              "$ref": "#/components/schemas/KeyComponent"
            }
          }
        },
        "required": ["strength", "scheme", "components"]
      },
      "Endpoint": {
        "type": "object",
        "description": "One end of a binding or one target of an action.",
        "properties": {
          "kind": {
            "type": "string",
            "description": "type, trait or any."
          },
          "ref": {
            "type": ["string", "null"],
            "description": "The id of the type or the trait; null for any."
          }
        },
        "required": ["kind", "ref"]
      },
      "Binding": {
        "type": "object",
        "description": "One pair of ends a link type may join.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The binding id."
          },
          "from": {
            "$ref": "#/components/schemas/Endpoint"
          },
          "to": {
            "$ref": "#/components/schemas/Endpoint"
          },
          "cardinality": {
            "type": "string",
            "description": "The cardinality, such as 1:n."
          },
          "param_constraints": {
            "type": "object",
            "description": "The values this binding accepts for a parameter of the meaning.",
            "additionalProperties": {
              "type": "array",
              "description": "The accepted values.",
              "items": {
                "type": "string",
                "description": "A value."
              }
            }
          }
        },
        "required": ["id", "from", "to", "cardinality", "param_constraints"]
      },
      "BoundLink": {
        "type": "object",
        "description": "A binding with the link type it belongs to.",
        "properties": {
          "link_type": {
            "type": "string",
            "description": "The link type id."
          },
          "binding": {
            "$ref": "#/components/schemas/Binding"
          }
        },
        "required": ["link_type", "binding"]
      },
      "TypeRef": {
        "type": "object",
