    "/v1/catalog/error-codes": {
      "get": {
        "operationId": "listErrorCodes",
        "summary": "The error codes",
        "description": "The closed catalogue of error codes. Every problem the server sends uses one of these.",
        "tags": ["catalog"],
        "x-required-role": ["authenticated"],
        "x-safe": true,
        "x-long-running": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "style": "deepObject",
            "explode": true,
            "description": "filter[<field>][<operation>]=<value>. Two filters on one field both apply (and). A field or operation not listed here is refused (invalid_input.filter_field_unknown, invalid_input.filter_op_unknown).",
            "schema": {
              "type": "object",
              "properties": {
                "group": {
                  "type": "object",
                  "description": "Filter on group.",
                  "properties": {
                    "equals": {
                      "type": "string",
                      "description": "Exactly this value."
                    },
                    "in": {
                      "type": "string",
                      "description": "Any of these values, separated by commas."
                    }
                  }
                },
                "status": {
                  "type": "object",
                  "description": "Filter on status.",
                  "properties": {
                    "equals": {
                      "type": "string",
                      "description": "Exactly this value."
                    },
                    "in": {
                      "type": "string",
                      "description": "Any of these values, separated by commas."
                    },
                    "range": {
                      "type": "string",
                      "description": "A number range from..to; either side may be empty."
                    }
                  }
                },
                "code": {
                  "type": "object",
                  "description": "Filter on code.",
                  "properties": {
                    "prefix": {
                      "type": "string",
                      "description": "Starts with this text."
                    }
                  }
                }
              }
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated fields to keep in each item. Selectable: code, group, meaning, status.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the list.",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              },
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCodeList"
                },
                "example": {
                  "data": [
                    {
                      "code": "auth.token_expired",
                      "group": "auth",
                      "meaning": "The bearer token has expired; get a new one.",
                      "status": 401
                    },
                    {
                      "code": "auth.token_invalid",
                      "group": "auth",
                      "meaning": "The bearer token is not accepted.",
                      "status": 401
                    }
                  ],
                  "meta": {
                    "model_hash": "712b5ae602cd347a",
