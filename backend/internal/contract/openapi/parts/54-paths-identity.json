{
  "paths": {
    "/v1/tokens/{token_id}": {
      "get": {
        "operationId": "getToken",
        "summary": "Look at an access token",
        "description": "Shows one access token and its state; never the secret or the hash. The id current stands for the token of this request, and then the answer also says who is calling (subject), which is the way to check a token. Any other id is answered to its owner and to an administrator; for anyone else it is not found.",
        "tags": [
          "identity"
        ],
        "x-required-role": [
          "authenticated"
        ],
        "x-safe": true,
        "x-long-running": false,
        "parameters": [
          {
            "name": "token_id",
            "in": "path",
            "required": true,
            "description": "The id of the token (not the token itself), or the word current.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The token.",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentTokenAnswer"
                },
                "example": {
                  "data": {
                    "subject": {
                      "id": "ada",
                      "kind": "person",
                      "display_name": "Ada Example",
                      "roles": [
                        "viewer"
                      ]
                    },
                    "token": {
                      "id": "pxm_0123456789abcdef",
                      "owner": "ada",
                      "owner_kind": "person",
                      "roles": [
                        "viewer"
                      ],
                      "description": "read only",
                      "state": "active",
                      "created_at": "2030-01-02T03:04:05Z",
                      "created_by": "root",
                      "expires_at": "2030-04-02T03:04:05Z",
                      "last_used_at": null,
                      "revoked_at": null,
                      "revoked_by": null
                    }
                  },
                  "meta": {
                    "trace_id": "tr-0123456789abcdef"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
